# Конфигурация Caddy — веб-сервера, который стоит «перед» приложением.
#
# Зачем он нужен:
#   1. HTTPS. Caddy сам получает сертификат Let's Encrypt для домена
#      и обновляет его — вручную ничего делать не нужно.
#   2. Безопасность. Наружу торчит только Caddy (порты 80 и 443),
#      само приложение доступно лишь изнутри Docker-сети.
#
# {$DOMAIN} подставляется из переменной окружения (файл .env на сервере).

{$DOMAIN} {
	# все запросы передаём контейнеру api внутри Docker-сети
	reverse_proxy api:8000 {
		# анализ записи идёт минуты — поднимаем таймауты,
		# иначе Caddy оборвёт соединение раньше, чем придёт ответ
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}

	# логи в формате JSON — единый стиль со всей системой
	log {
		output stdout
		format json
	}
}
