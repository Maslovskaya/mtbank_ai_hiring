# --- Обязательные секреты ---

# Ключ Groq (или другого OpenAI-совместимого провайдера): https://console.groq.com
GROQ_API_KEY=

# Токен Hugging Face для моделей диаризации pyannote: https://huggingface.co/settings/tokens
# Нужно также принять условия использования моделей:
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# --- Необязательные настройки (значения по умолчанию заданы в config.py) ---

# LLM: любой OpenAI-совместимый эндпоинт
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b

# ASR: размер модели faster-whisper и режим вычислений
# WHISPER_MODEL=medium
# WHISPER_DEVICE=cpu          # cuda — если есть GPU
# WHISPER_COMPUTE_TYPE=int8   # float16 — для GPU
# WHISPER_LANGUAGE=ru

# Диаризация
# DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# --- Только для развёртывания на сервере (docker-compose.prod.yml) ---

# Домен, на котором работает демо. Caddy получит для него HTTPS-сертификат.
# Пример: mtbank-analytics.duckdns.org
# DOMAIN=
